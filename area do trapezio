#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#define pi 3.141592


int main(int argc, char *argv[]) {
	
	float area, raio, b1, b2, h;
	
	printf("Insira o raio de um circulo\n");
	scanf("%f", &raio);
	
	area = pi*(raio*raio);
	
	printf("A Area do circulo de raio %f = %f", raio, area);
	
	printf("Agora a do trapezio\n");
	printf("Digite a altura do trapezio\n");
	scanf("%f", &h);
	printf("Digite a base menor\n");
	scanf("%f", &b1);
	printf("Digite a base maior\n");
	scanf("%f", &b2);
	
	area = ((b1 + b2)*h ) /2;
	printf("A area do trapezio e %f", area);
	
	return 0;
}
