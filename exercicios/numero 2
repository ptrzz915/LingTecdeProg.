#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int main(int argc, char *argv[]) {

	double numero, mantissa;
	int expoente;
	
	printf("Digite um valor: \n");
	scanf("%lf", &numero);
	
	expoente = (int)floor(log10(fabs(numero)));
	mantissa = numero / pow(10, expoente);
	
	printf("%.5fe^%d\n", mantissa, expoente);
	
	return 0;
